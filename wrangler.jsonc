{
  // Cloudflare Workers deployment. Build with `pnpm build:cf`, then `wrangler deploy`.
  "name": "road-to-doomsday",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./.output/server/index.mjs",
  "assets": { "binding": "ASSETS", "directory": "./.output/public" },
  "kv_namespaces": [
    // Create it once with `wrangler kv namespace create COLLECTORS` and paste the id it prints.
    { "binding": "COLLECTORS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
}
