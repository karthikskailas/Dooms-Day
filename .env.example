# Copy to .env and fill in. Never commit .env.
# Server-only TMDB "API Read Access Token" (the long v4 token, not the short v3 API key).
# Create one at https://www.themoviedb.org/settings/api
NUXT_TMDB_API_TOKEN=
# Optional. Defaults to https://api.tmdb.org/3, which served the same API more reliably than
# https://api.themoviedb.org/3 on the development network. Only those two TMDB hosts are accepted,
# because the token is sent to this URL.
NUXT_TMDB_API_BASE_URL=
# Default watch-provider region (ISO 3166-1 alpha-2). The providers route also accepts ?region=XX.
NUXT_PUBLIC_TMDB_REGION=IN
